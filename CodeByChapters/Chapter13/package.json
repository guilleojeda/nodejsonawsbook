{
  "name": "simple-aws-nodejs-app-tracing",
  "version": "1.0.0",
  "private": true,
  "description": "OpenTelemetry tracing and custom metrics sample for Building Highly Available Applications on AWS.",
  "author": "Guille Ojeda",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node -r ./tracing.js app.js",
    "smoke": "node scripts/smoke-test.js --preload=./tracing.js",
    "metrics:test": "node scripts/metrics-test.js",
    "test": "npm run metrics:test && npm run smoke"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.0.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.221.0",
    "@opentelemetry/id-generator-aws-xray": "2.1.0",
    "@opentelemetry/propagator-aws-xray": "2.2.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "body-parser": "^1.20.9",
    "express": "^4.22.3",
    "pg": "^8.23.1"
  },
  "overrides": {
    "gcp-metadata@8.1.4": {
      "gaxios": "7.1.4"
    }
  }
}
